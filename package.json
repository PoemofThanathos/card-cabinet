{
  "name": "card-cabinet",
  "version": "1.0.0",
  "license": "PolyForm-Strict-1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:rules": "firebase emulators:exec --only firestore --project demo-card-cabinet \"vitest run --config vitest.rules.config.ts\"",
    "worker:dev": "wrangler dev --config worker/wrangler.toml",
    "worker:check": "wrangler deploy --dry-run --config worker/wrangler.toml",
    "worker:deploy": "wrangler deploy --config worker/wrangler.toml"
  },
  "dependencies": {
    "dexie": "^4.2.1",
    "dexie-react-hooks": "^4.2.0",
    "fflate": "^0.8.2",
    "firebase": "^13.2.0",
    "jose": "^6.1.0",
    "lucide-react": "^1.70.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.12"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.7",
    "@opentelemetry/core": "^2.8.0",
    "glob": "^14.0.4",
    "minimatch": "^11.0.5",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261109.1",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^6.3.0",
    "fake-indexeddb": "^6.2.4",
    "firebase-tools": "^15.35.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vite": "^8.3.7",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0",
    "wrangler": "^4.46.0"
  }
}
